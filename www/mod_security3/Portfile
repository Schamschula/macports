                    --with-pcre=${prefix}/bin/pcre-config \
                    --with-curl=${prefix}/bin/curl-config \
                    --with-libxml=${prefix} \
                    --with-lua=${prefix} \
                    --with-ssdeep=${prefix} \
                    --with-yajl=${prefix}
