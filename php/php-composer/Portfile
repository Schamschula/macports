# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0

name                php-composer
version             2.10.3
revision            0

categories          php
license             MIT
maintainers         {mps @Schamschula} openmaintainer
description         Composer is a tool for dependency management in PHP.
long_description    ${description} It allows you to declare the libraries your project \
                    depends on and it will manage (install/update) them for you.
supported_archs     noarch
homepage            https://getcomposer.org/
master_sites        ${homepage}
distfiles           installer

checksums           installer \
                    rmd160  5be9359f8ce15ee9203043b9dbf6cf62d32860a8 \
                    sha256  aad0c40a36d9938664f5a34eb2ed39dbc1021792f9706dbcb9cd6d8001227c99 \
                    size    59524

variant php83 conflicts php84 php85 description {Use php 8.3} {}
variant php84 conflicts php83 php85 description {Use php 8.4} {}
variant php85 conflicts php83 php84 description {Use php 8.5} {}

if {![variant_isset php83] && ![variant_isset php84]} {
    default_variants +php85
}

foreach pv {85 84 83} {
    if {[variant_isset php${pv}]} {
        set php_branch ${pv}
        break
    }
}

depends_lib         port:php${php_branch} \
                    port:php${php_branch}-mbstring \
                    port:php${php_branch}-openssl

use_configure       no

extract {
    file copy ${distpath}/installer ${workpath}/composer-setup.php
}

build   {}

destroot {
    exec ${prefix}/bin/php${php_branch} ${workpath}/composer-setup.php \
        --install-dir=${destroot}${prefix}/bin --filename=composer
}

livecheck.type      regexm
livecheck.url       ${homepage}download/
livecheck.regex     {v(\d+\.\d+\.\d+)}
